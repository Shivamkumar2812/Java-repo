import java.util.Scanner;

class Employee
{
    String name;
    int age;
    double salary;

    void create(Scanner sc)
    {
        System.out.println("Enter your Name:");
        name = sc.nextLine();

        System.out.println("Enter your Age:");
        age = sc.nextInt();

        System.out.println("Enter your Salary:");
        salary = sc.nextDouble();

        sc.nextLine(); // clear Enter key

        System.out.println("Do you want to create this employee? (y/n)");
        String choice = sc.nextLine();

        if (choice.equalsIgnoreCase("y"))
        {
            System.out.println("Employee created successfully!");
        }
        else
        {
            System.out.println("Employee not created.");
            name = "";
            age = 0;
            salary = 0;
        }
    }

    void display()
    {
        if (name.equals(""))
        {
            System.out.println("No employee record found.");
        }
        else
        {
            System.out.println("\n--- Employee Details ---");
            System.out.println("Name   : " + name);
            System.out.println("Age    : " + age);
            System.out.println("Salary : " + salary);
        }
    }

    void raiseSalary(Scanner sc)
    {
        if (name.equals(""))
        {
            System.out.println("No employee record found.");
            return;
        }

        System.out.println("Enter salary raise percentage:");
        double percentage = sc.nextDouble();

        salary = salary + (salary * percentage / 100);

        System.out.println("Salary raised successfully!");
        System.out.println("New Salary: " + salary);
    }
}

public class EmployeeManagement
{
    public static void main(String[] args)
    {
        Scanner sc = new Scanner(System.in);

        Employee emp = new Employee();

        int choice;

        do
        {
            System.out.println("\n===== EMPLOYEE MANAGEMENT SYSTEM =====");
            System.out.println("1) Create");
            System.out.println("2) Display");
            System.out.println("3) Raise Salary");
            System.out.println("4) Exit");

            System.out.println("Enter your choice:");
            choice = sc.nextInt();
            sc.nextLine();

            switch (choice)
            {
                case 1:
                    emp.create(sc);
                    break;

                case 2:
                    emp.display();
                    break;

                case 3:
                    emp.raiseSalary(sc);
                    break;

                case 4:
                    System.out.println("Exiting program...");
                    break;

                default:
                    System.out.println("Invalid choice!");
            }

        } while (choice != 4);

        sc.close();
    }
}
