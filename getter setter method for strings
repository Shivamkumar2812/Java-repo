class Parent {

    private String name;

    // Setter
    public void setName(String name) {
        this.name = name;
    }

    // Getter
    public String getName() {
        return name;
    }
}

class Demo extends Parent {

    public static void main(String[] args) {

        Demo bb = new Demo();

        bb.setName("Shivam");

        String ss = bb.getName();

        System.out.println(ss);
    }
}
